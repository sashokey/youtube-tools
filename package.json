{
  "name": "youtube-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "test": "node --test tests/*.test.ts",
    "test:stock": "node --test tests/live/stock.test.ts",
    "test:live": "node --test tests/live/features.test.ts tests/live/sponsorblock.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.0",
    "@types/node": "24.19.2",
    "@violentmonkey/types": "0.3.4",
    "chrome-types": "0.1.461",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "playwright": "1.62.1",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "user-agent-data-types": "0.4.2"
  }
}
